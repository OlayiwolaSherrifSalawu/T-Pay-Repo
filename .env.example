# Copy to .env. Real values never go in the repository.

# PayPal sandbox app, from https://developer.paypal.com/dashboard/applications/sandbox
# These stay on the server. T-Pay refuses to start with PAYPAL_ENV set to anything else.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# From the webhook you register for <APP_URL>/api/v1/webhooks/paypal. Optional locally.
PAYPAL_WEBHOOK_ID=""

# Google AI Studio key for the online assistant. Without it, the rule-based parser still works.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Where PayPal sends the payer back to after approval.
APP_URL="http://localhost:3000"

# Naira per US dollar. A fixed demo rate, labelled as such in the interface.
FX_NGN_PER_USD="1500"
FX_SOURCE="demo-fixed-rate"

DATABASE_PATH="data/tpay.db"
PORT="4000"
